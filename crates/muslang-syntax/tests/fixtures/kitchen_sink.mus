pub fn control(a: i32, mut b: i32) -> ! {
    b += a << 2 >> 1 | 3 ^ 4 & 5;
    b *= 2;
    let big = 0b1010_1010 + 0o777 + 0xDEAD_beef;
    let f = 1.5e-3f64;
    let s = r#"raw "with" quotes"#;
    let ch = '\u{1F600}';
    let pair: (i32, f32) = (1, 2.5f32);
    let t = pair.0;
    let sl: &[u8] = &[1, 2, 3];

    match pair {
        (0, y) => y,
        (x, 2.5f32) if x > 0 => x,
        ('a'..='z') => 0,
        Point { x, y: p } => x + p.0,
        _ => 0,
    };

    for pat in 0..10 {
        defer b = pat;
    }
    while let Some(v) = next() {
        errdefer rollback();
        if v == 3 {
            continue;
        } else {
            break;
        }
    }
    loop {
        async {
            inner().await?;
        }
    }
    let cl = move |x: i32, y| -> i32 {
        x + y
    };
    let neg = !a != -t;
    let cast = big as u64;
    @cImport("math.h");
    panic!("unreachable {}/{}", a, b);
}

pub async fn fetch(url: &str) -> Vec::<u8> {
    while ready() {
        step().await;
    }
    body()
}

fn next() -> Option::<i32> {
