extern "C" {
    #[muslang::strategy(A)]
    fn malloc(size: usize) -> *anyopaque;
    #[muslang::strategy(C)]
    fn c_write(fd: c_int, buf: *const u8, len: usize) -> c_int;
}

pub const MAX: u32 = 0xFF_u32;
static mut COUNTER: i64 = -1_000;
pub type Rows = Vec::<Vec::<u8>>;

pub struct Point<T: Clone + 'static>
where
    T: PartialEq,
{
    pub x: T,
    y: [T; 4],
}

pub enum Shape {
    Circle { r: f64 },
    Rect(f64, f64),
    Empty,
}

pub trait Draw {
    fn draw(&self) -> Result<(), String>;
    fn id(&self) -> u64 {
        0
    }
}

impl<T: Draw> Draw for Point<T> {
    fn draw(&self) -> Result<(), String> {
        defer cleanup(self);
        self.x.draw()
    }
}

